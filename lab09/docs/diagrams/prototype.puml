@startuml
title Prototype — Копіювання банківських договорів

class Contract <<Prototype>> {
    - productType: String
    - interestRate: double
    - termMonths: int
    - amount: double
    - customer: String
    - earlyTerminationConditions: String
    - schedule: PaymentSchedule
    - agreements: List<AdditionalAgreement>
    + Contract(...)
    + {static} createTemplate(): Contract
    + cloneForCustomer(customer, amount): Contract
    + addAgreement(agreement): void
    + setAmount(amount): void
    + getSchedule(): PaymentSchedule
    + toString(): String
}

class PaymentSchedule {
    - payments: List<String>
    + PaymentSchedule(payments)
    + copy(): PaymentSchedule
    + changePayment(index, value): void
    + toString(): String
}

class AdditionalAgreement {
    - description: String
    + AdditionalAgreement(description)
    + copy(): AdditionalAgreement
    + toString(): String
}

class ContractManager <<Client>> {
    + createCustomerContract(): Contract
}

Contract "1" *-- "1" PaymentSchedule : графік платежів
Contract "1" *-- "0..*" AdditionalAgreement : додаткові угоди
ContractManager ..> Contract : клонує прототип

note right of Contract
  Клієнтський договір
  створюється копіюванням.
  Вкладені об'єкти також
  копіюються (Deep Copy).
end note

note bottom of PaymentSchedule
  Кожен договір має
  власний графік платежів.
end note

@enduml