@startuml
title Object Pool — Захищені платіжні з'єднання

class PaymentConnectionPool <<Object Pool>> {
    - maxConnections: int
    - createdConnections: int
    - available: Queue<PaymentConnection>
    - active: Queue<PaymentConnection>
    - waiting: Queue<Payment>
    - allConnections: List<PaymentConnection>
    + PaymentConnectionPool(maxConnections)
    + submit(payment): void
    - assignPayment(connection, payment): void
    + completeNext(): void
    + hasActivePayments(): boolean
    + getCreatedConnections(): int
    + printStatistics(): void
}

class PaymentConnection <<Pooled Object>> {
    - id: String
    - currentPayment: Payment
    - paymentsProcessed: int
    + PaymentConnection(id)
    + process(payment): void
    + clear(): void
    + getId(): String
    + getPaymentsProcessed(): int
}

class Payment {
    - id: int
    - amount: double
    - fromAccount: String
    - toAccount: String
    + Payment(id, amount, from, to)
    + getId(): int
    + getAmount(): double
    + getFromAccount(): String
    + getToAccount(): String
}

PaymentConnectionPool "1" o-- "0..4" PaymentConnection : керує
PaymentConnectionPool ..> Payment : приймає
PaymentConnection --> "0..1" Payment : обробляє

note right of PaymentConnectionPool
  Максимум 4 з'єднання.
  Черга FIFO.
  Вільні з'єднання
  використовуються повторно.
end note

note bottom of PaymentConnection
  Після платежу:
  1. Очищення даних.
  2. Повернення до пулу.
  3. Повторне використання.
end note

@enduml