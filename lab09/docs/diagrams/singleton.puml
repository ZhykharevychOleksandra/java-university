@startuml
title Singleton — Служба курсів валют банку

class ExchangeRate {
    - currency: String
    - buy: double
    - sell: double
    + ExchangeRate(currency, buy, sell)
    + toString(): String
}

class ExchangeRateService <<Singleton>> {
    - {static} Holder: class
    - rates: Map<String, ExchangeRate>
    - ExchangeRateService()
    + {static} getInstance(): ExchangeRateService
    + setRate(currency, buy, sell): void
    + getRate(currency): ExchangeRate
}

class Holder <<Singleton Holder>> {
    - {static} INSTANCE: ExchangeRateService
}

class Treasury <<Client>> {
    + setRate(): void
}

class Branch <<Client>> {
    + getRate(): ExchangeRate
}

class OnlineBanking <<Client>> {
    + getRate(): ExchangeRate
}

Holder *-- ExchangeRateService
ExchangeRateService "1" *-- "0..*" ExchangeRate
Treasury ..> ExchangeRateService : отримує курс
Branch ..> ExchangeRateService : читає курс
OnlineBanking ..> ExchangeRateService : читає курс

note right of ExchangeRateService
  Приватний конструктор.
  Один екземпляр на весь банк.
  Потокобезпечне створення
  через Holder.
end note

@enduml